;===================================================================================
; hdr.asm - AUTO-GENERATED by snes_rules from your Makefile variables.
; Do not edit by hand — changes are overwritten on the next `make`.
; To hand-write your own, set AUTOHDR := 0 in your Makefile and ship hdr.asm yourself.
;===================================================================================

.MEMORYMAP
SLOTSIZE $8000
DEFAULTSLOT 0
SLOT 0 $8000
SLOT 1 $0 $2000
SLOT 2 $2000 $E000
SLOT 3 $0 $10000
.ENDME

.ROMBANKSIZE $8000
.ROMBANKS @ROMBANKS@

.SNESHEADER
ID "SNES"
NAME "@ROMTITLE@"
@ROMSPEED@
@ROMMODE@
CARTRIDGETYPE $@CARTRIDGETYPE@
ROMSIZE $@ROMSIZE@
SRAMSIZE $@SRAMSIZE@
COUNTRY $@COUNTRY@
LICENSEECODE $@LICENSEECODE@
VERSION $@VERSION@
.ENDSNES

.SNESNATIVEVECTOR
COP EmptyHandler
BRK EmptyHandler
ABORT EmptyHandler
NMI VBlank
IRQ EmptyHandler
.ENDNATIVEVECTOR

.SNESEMUVECTOR
COP EmptyHandler
ABORT EmptyHandler
NMI EmptyHandler
RESET tcc__start
IRQBRK EmptyHandler
.ENDEMUVECTOR
